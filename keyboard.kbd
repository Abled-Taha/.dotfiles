(defcfg
  ;; For Linux
  input  (device-file "/dev/input/by-id/usb-Dell_Dell_USB_Keyboard-event-kbd")
  output (uinput-sink "My KMonad output"
    "/run/current-system/sw/bin/sleep 1 && /run/current-system/sw/bin/setxkbmap -option compose:sclk")
  cmp-seq slck
  cmp-seq-delay 5

  fallthrough true
  allow-cmd true
)

(defsrc
  esc  f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12         prnt slck pause
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc   ins  home pgup  nlck kp/  kp*  kp-
  tab  q    w    e    r    t    y    u    i    o    p    [    ]           del  end  pgdn  kp7  kp8  kp9  kp+
  caps a    s    d    f    g    h    j    k    l    ;    '    \    ret                kp4  kp5  kp6
  lsft z    x    c    v    b    n    m    ,    .    /              rsft       up         kp1  kp2  kp3  kprt
  lctl lmet lalt            spc            ralt rmet cmp  rctl            left down rght  kp0  kp.
)

(deflayer main
  caps f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12         prnt slck pause
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc   ins  home pgup  nlck kp/  kp*  kp-
  tab  q    w    e    r    t    y    u    i    o    p    [    ]           del  end  pgdn  kp7  kp8  kp9  kp+
  esc  a    s    d    f    g    h    j    k    l    ;    '    \    ret                kp4  kp5  kp6
  lsft z    x    c    v    b    n    m    ,    .    /              rsft       up         kp1  kp2  kp3  kprt
  lctl lmet lalt            spc       ralt rmet cmp  rctl            left down rght  kp0  kp.
)

(deflayer arrow-layer
  caps f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12         prnt slck pause
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc   ins  home pgup  nlck kp/  kp*  kp-
  tab  q    w    e    r    t    y    u    i    o    p    [    ]           del  end  pgdn  kp7  kp8  kp9  kp+
  esc  a    s    d    f    g    left down up   right ;    '    \    ret                kp4  kp5  kp6
  lsft z    x    c    v    b    n    m    ,    .    /              rsft       up         kp1  kp2  kp3  kprt
  lctl lmet lalt            @spc_mod       ralt rmet cmp  rctl            left down rght  kp0  kp.
)

(defalias
  ;; Tapping space = space
  ;; Holding space = toggles the arrow-layer cleanly
  spc_mod (tap-hold 200 spc (layer-toggle arrow-layer))
)
