// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "agent": {
    "threads_sidebar": {
      "position": "right"
    },
    "favorite_models": [],
    "model_parameters": []
  },
  "agent_servers": {
    
  },
  "cli_default_open_behavior": "existing_window",
  "terminal": {
    "button": false
  },
  "debugger": {
    "button": false
  },
  "outline_panel": {
    "button": false
  },
  "collaboration_panel": {
    "button": false
  },
  "project_panel": {
    "dock": "left"
  },
  "proxy": "",
  "disable_ai": true,
  "relative_line_numbers": "enabled",
  "which_key": {
    "enabled": true
  },
  "base_keymap": "VSCode",
  "vim_mode": true,
  "auto_update": false,
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
    "anthropic_retention": false
  },
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": "Ayu Dark",
}
